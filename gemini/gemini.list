# --------------------
# 登录跳转（防掉登录态）
# --------------------
URL-REGEX,^https?://www\.google\.com/.*continue=https://gemini\.google\.com.+

# --------------------
# 宽松关键词（来自 blackmatrix7，可能误伤，不需要可删）
# --------------------
HOST-KEYWORD,generativelanguage,PROXY
HOST-KEYWORD,colab,PROXY
HOST-KEYWORD,developerprofiles,PROXY
